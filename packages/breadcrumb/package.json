{
  "name": "@next-box/breadcrumb",
  "description": "A library for creating a breadcrumb for use in React applications.",
  "version": "0.0.3",
  "author": "Dylan Aubrey",
  "license": "MIT",
  "homepage": "https://github.com/badbatch/next-box",
  "repository": {
    "directory": "packages/breadcrumb",
    "type": "git",
    "url": "https://github.com/badbatch/next-box/packages/breadcrumb"
  },
  "bugs": "https://github.com/badbatch/next-box/issues",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/cjs/index.d.cts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "types": {
        "import": "./dist/types/esm/index.d.ts",
        "require": "./dist/types/cjs/index.d.cts"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean:dist && pnpm run compile",
    "clean:deps": "del-cli ./node_modules",
    "clean:dist": "del-cli ./dist",
    "compile": "pnpm run /^compile:.*/",
    "compile:cjs": "MODULE_SYSTEM=cjs rollup -c ../../rollup.config.cjs",
    "compile:esm": "rollup -c ../../rollup.config.cjs",
    "compile:types": "tsc --project ./tsconfig.build.json && cts-types build dist/types/esm dist/types/cjs"
  },
  "dependencies": {
    "@cachemap/core": "^5.2.3",
    "@cachemap/web-storage": "^5.1.3",
    "@types/lodash-es": "^4.17.12",
    "core-js": "^3.39.0",
    "lodash-es": "^4.17.21",
    "type-fest": "^4.31.0"
  },
  "peerDependencies": {
    "react": "<19",
    "react-dom": "<19"
  },
  "devDependencies": {
    "@jest/globals": "^29.3.1",
    "@types/react": "^18.2.46",
    "@types/react-dom": "^18.2.18",
    "cts-types": "^0.0.8",
    "del-cli": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
