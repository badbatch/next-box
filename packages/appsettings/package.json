{
  "name": "@next-box/appsettings",
  "description": "A configuration management library for TypeScript applications, inspired by .NET’s appsettings.json.",
  "version": "0.0.6",
  "author": "miami-man",
  "license": "MIT",
  "homepage": "https://github.com/badbatch/next-box",
  "repository": {
    "directory": "packages/appsettings",
    "type": "git",
    "url": "https://github.com/badbatch/next-box.git"
  },
  "bugs": "https://github.com/badbatch/next-box/issues",
  "type": "module",
  "bin": {
    "appsettings": "./bin/appsettings.mjs"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/types/cjs/index.d.cts",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": {
        "import": "./dist/types/esm/index.d.ts",
        "require": "./dist/types/cjs/index.d.cts"
      },
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs"
    },
    "./cli": {
      "source": "./src/cli/index.ts",
      "types": {
        "import": "./dist/types/esm/cli.d.ts",
        "require": "./dist/types/cjs/cli.d.cts"
      },
      "import": "./dist/esm/cli.mjs",
      "require": "./dist/cjs/cli.cjs"
    },
    "./server": {
      "source": "./src/server.ts",
      "types": {
        "import": "./dist/types/esm/server.d.ts",
        "require": "./dist/types/cjs/server.d.cts"
      },
      "import": "./dist/esm/server.mjs",
      "require": "./dist/cjs/server.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run clean:dist && pnpm run compile",
    "clean:deps": "del-cli ./node_modules",
    "clean:dist": "del-cli ./dist",
    "compile": "pnpm run /^compile:.*/",
    "compile:cjs": "MODULE_SYSTEM=cjs rollup -c ./rollup.config.mjs",
    "compile:esm": "rollup -c ./rollup.config.mjs",
    "compile:types": "tsc --project ./tsconfig.build.json && cts-types build dist/types/esm dist/types/cjs",
    "type-check": "tsc --project ./tsconfig.json --noEmit --composite false --declaration false --declarationMap false --emitDeclarationOnly false"
  },
  "dependencies": {
    "remeda": "^2.58.0",
    "yargs": "^18.2.0",
    "zcb": "^0.3.10",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yargs": "^17.0.35",
    "cts-types": "^0.0.17",
    "del-cli": "^8.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "type-fest": "^5.10.0"
  }
}
