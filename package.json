{
  "name": "next-box",
  "description": "A collection of libraries for use primarily with Next.js.",
  "version": "0.0.37",
  "author": "miami-man",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/badbatch/next-box",
  "repository": "badbatch/next-box",
  "bugs": "https://github.com/badbatch/next-box/issues",
  "type": "module",
  "engines": {
    "node": "^22",
    "pnpm": "^9"
  },
  "scripts": {
    "build": "NODE_ENV=production pnpm run -r build",
    "clean:deps": "pnpm run -r clean:deps && del-cli ./node_modules",
    "clean:dist": "pnpm run -r clean:dist",
    "cut:changelog": "changelog",
    "installActivateMise": "sh shellScripts/installActivateMise.sh",
    "lint": "pnpm run /^lint:.*/",
    "lint:code": "eslint .",
    "lint:docs": "markdownlint-cli2 --config \".markdownlint.json\" \"**/*.md\" \"!**/node_modules/**\"",
    "new:package": "pnpm run repodog new pkg library",
    "repodog": "repodog",
    "syncpack": "syncpack format && syncpack list-mismatches && syncpack lint-semver-ranges",
    "test": "COMPILER=swc node --require=suppress-experimental-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --passWithNoTests",
    "type-check": "tsc --noEmit",
    "validate": "pnpm run syncpack && pnpm run build && pnpm run lint && pnpm run type-check && pnpm run test"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@jest/globals": "^29.7.0",
    "@repodog/cli": "^1.6.43",
    "@repodog/commitlint-config": "^19.0.3",
    "@repodog/eslint-config": "^9.0.15",
    "@repodog/eslint-config-jest": "^9.0.4",
    "@repodog/eslint-config-react": "^9.0.4",
    "@repodog/jest-config": "^29.0.4",
    "@repodog/markdownlint-config": "^1.2.4",
    "@repodog/prettier-config": "^3.0.2",
    "@repodog/rollup-config": "^4.0.9",
    "@repodog/swc-config": "^1.0.10",
    "@repodog/syncpack-config": "^13.0.3",
    "@repodog/ts-config": "^5.0.4",
    "@rollup/plugin-swc": "^0.3.0",
    "@swc/core": "^1.7.26",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "del-cli": "^6.0.0",
    "eslint": "^9.17.0",
    "generate-changelog": "^1.8.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "markdownlint-cli2": "^0.17.1",
    "prettier": "^3.4.2",
    "rollup": "^4.41.1",
    "suppress-experimental-warnings": "^2.0.0",
    "syncpack": "^13.0.0",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@babel/helpers": ">=7.26.10",
      "@babel/runtime": ">=7.26.10"
    }
  }
}
